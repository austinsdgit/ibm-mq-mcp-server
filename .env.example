# IBM MQ Connection Configuration
IBMMQ_QUEUE_MANAGER=QM1
IBMMQ_CHANNEL=DEV.APP.SVRCONN
IBMMQ_HOST=localhost
IBMMQ_PORT=1414
IBMMQ_USERNAME=app
IBMMQ_PASSWORD=passw0rd

# SSL/TLS Configuration (optional)
IBMMQ_USE_SSL=false
# IBMMQ_SSL_CIPHER_SPEC=TLS_RSA_WITH_AES_256_CBC_SHA256
# IBMMQ_SSL_KEY_REPOSITORY=/path/to/key/repository

# Connection Options
IBMMQ_CONNECTION_TIMEOUT=30
IBMMQ_MAX_RETRIES=3

# MCP Server Configuration
MCP_SERVER_NAME=ibm-mq-mcp-server
MCP_SERVER_VERSION=0.1.0
MCP_CURRENT_USER_ID=admin_user
MCP_LOG_LEVEL=INFO

# Authorization Configuration
USERS_CONFIG_PATH=users.json